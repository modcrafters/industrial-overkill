<screen xmlns="https://moddev.zone/mmdlib/screen" title="trap.title" title-fallback="Mob Trap"
        inventory="none" block-entity="zone.moddev.mc.industrialoverkill.trap.MobTrapEntity" extends="mmdlib:base_machine">
  <fill name="body">
    <hbox padding="8" spacing="10" align="center">
      <custom id="portrait" type="industrial_overkill:animal_portrait" width="72" height="72" value="#getAnimalId"/>
      <custom id="status" type="industrial_overkill:gym_status" width="170" height="66" value="#getStatusText"/>
      <vbox spacing="8">
        <button id="trap_release" icon="industrial_overkill:trap_release"
                on-click="industrial_overkill:trap_release" tooltip="trap.release.tip"
                tooltip-fallback="Release the mob into clear space beside the cage."/>
        <button id="trap_pickup" icon="industrial_overkill:trap_pickup"
                on-click="industrial_overkill:trap_pickup" tooltip="trap.pickup.tip"
                tooltip-fallback="Pick up this trap with its occupant safely inside."/>
      </vbox>
    </hbox>
  </fill>
  <fill name="inventory_controls"/>
  <fill name="info"/>
</screen>
