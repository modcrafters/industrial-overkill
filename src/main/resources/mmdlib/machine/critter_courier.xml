<machine xmlns="https://moddev.zone/mmdlib/machine" version="1"
         extends="industrial_overkill:base_portable_machine" name="Critter Courier">
  <block hardness="2.5" stack-size="1" no-occlusion="true" immovable="true"
         portable="true" requires-tool="false" on-secondary-use="mmdlib:pickup"/>
  <appearance preset="model" model="industrial_overkill:block/critter_courier_empty">
    <part id="plate" model="industrial_overkill:block/critter_courier_plate"
          when="!$processors.courier.occupied"/>
    <part id="cage" model="industrial_overkill:block/critter_courier_cage"
          when="$processors.courier.occupied"/>
    <entity-display variable="$processors.courier.occupant"
                    offset="0.5 0.2 0.5" width="0.62" height="0.45" item-yaw="180"
                    item-property="industrial_overkill:occupied"/>
  </appearance>
  <storage/>
  <shapes>
    <shape id="plate" bounds="0 0 0 16 3 16" when="!$processors.courier.occupied"/>
    <shape id="cage" bounds="0 0 0 16 16 16" when="$processors.courier.occupied"/>
  </shapes>
  <processor id="courier" class="net.modcrafters.minecraft.industrialoverkill.courier.CritterCourierProcessor"/>
  <screen xmlns="https://moddev.zone/mmdlib/screen"
          inventory="none">
    <fill name="machine">
      <hbox padding="8" spacing="10" align="center">
        <entity-portrait id="portrait" variable="$processors.courier.occupant"
                         width="72" height="72" empty-text="gym.no_animal"/>
        <label id="status" variable="$processors.courier.details"
               width="170" height="66" translate-lines="true"/>
        <vbox spacing="8">
          <button id="courier_release" processor="courier"
                  on-click="industrial_overkill:release"
                  enabled-when="$processors.courier.occupied &amp;&amp; !$processors.courier.taken"
                  icon="industrial_overkill:courier_release" tooltip="courier.release.tip"/>
          <button id="courier_pickup" processor="courier"
                  on-click="mmdlib:pickup"
                  enabled-when="!$processors.courier.taken"
                  icon="industrial_overkill:courier_pickup" tooltip="courier.pickup.tip"/>
        </vbox>
      </hbox>
    </fill>
    <fill name="inventory_controls"/>
  </screen>
</machine>
