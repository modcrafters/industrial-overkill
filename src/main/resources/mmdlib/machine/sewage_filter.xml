<?xml version="1.0" encoding="UTF-8"?>
<machine xmlns="https://moddev.zone/mmdlib/machine" version="1"
         extends="industrial_overkill:base_powered_machine" name="Sewage Filter">
  <appearance preset="model" model="industrial_overkill:block/sewage_filter_body">
    <face-overlay id="display_idle" face="front" x="0" y="0" width="16" height="16"
                  texture="industrial_overkill:block/ranching/sewage_filter/front"
                  when="!($processors.filter.running &amp;&amp; !$processors.filter.paused)"/>
    <face-overlay id="display_powered" face="front" x="0" y="0" width="16" height="16"
                  texture="industrial_overkill:block/ranching/sewage_filter/front" emissive="true"
                  when="$processors.filter.running &amp;&amp; !$processors.filter.paused"/>
    <part id="powered_sides" model="industrial_overkill:block/machine/ranching_powered_sides"
          when="$processors.filter.running"/>
  </appearance>
  <recipe-type id="industrial_overkill:sewage_filter" declare="true" name="Sewage Filtering"/>
  <parts>
    <tank id="raw_input" name="Input" capacity="4000" role="input" tooltip="waste.filter.input"/>
    <processor id="filter" recipe-type="industrial_overkill:sewage_filter"
               bindings="input=raw_input liquid=filtered_output solids=solids" filter-inputs="input"/>
    <inventory id="solids" name="Solid Output" count="9" role="output"/>
    <tank id="filtered_output" name="Liquid Output" capacity="4000" role="output" tooltip="waste.filter.output"/>
    <energy/>
  </parts>
</machine>
