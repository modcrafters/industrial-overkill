<?xml version="1.0" encoding="UTF-8"?>
<machine xmlns="https://moddev.zone/mmdlib/machine" version="1"
         extends="industrial_overkill:base_powered_machine" name="Rock Stew Factory">
  <appearance preset="model" model="industrial_overkill:block/rock_stew_factory_casing">
    <face-overlay id="progress_1" face="front" x="4.5" y="13.5" width="1" height="1"
                  texture="industrial_overkill:block/resource/rock_stew/powered_light" frames="8"
                  variable="$processors.rock_stew.progress_lights_1" emissive="true"/>
    <face-overlay id="progress_2" face="front" x="6" y="13.5" width="1" height="1"
                  texture="industrial_overkill:block/resource/rock_stew/powered_light" frames="8"
                  variable="$processors.rock_stew.progress_lights_2" emissive="true"/>
    <face-overlay id="progress_3" face="front" x="7.5" y="13.5" width="1" height="1"
                  texture="industrial_overkill:block/resource/rock_stew/powered_light" frames="8"
                  variable="$processors.rock_stew.progress_lights_3" emissive="true"/>
    <face-overlay id="progress_4" face="front" x="9" y="13.5" width="1" height="1"
                  texture="industrial_overkill:block/resource/rock_stew/powered_light" frames="8"
                  variable="$processors.rock_stew.progress_lights_4" emissive="true"/>
    <face-overlay id="progress_5" face="front" x="10.5" y="13.5" width="1" height="1"
                  texture="industrial_overkill:block/resource/rock_stew/powered_light" frames="8"
                  variable="$processors.rock_stew.progress_lights_5" emissive="true"/>

    <part id="powered_sides" model="industrial_overkill:block/machine/resource_powered_sides"
          when="$processors.rock_stew.running &amp;&amp; !$processors.rock_stew.paused &amp;&amp; !$processors.rock_stew.held"/>
    <part id="powered_panels" model="industrial_overkill:block/rock_stew_factory_powered_panels"
          when="$processors.rock_stew.running &amp;&amp; !$processors.rock_stew.paused &amp;&amp; !$processors.rock_stew.held"/>
    <item-display variable="$processors.rock_stew.display_product" width="0.4" height="0.4" />
  </appearance>
  <storage>
    <fluids id="fluids">
      <tank id="water" name="Water" capacity="4000" role="input" fluid="minecraft:water"/>
      <tank id="lava" name="Lava" capacity="4000" role="input" fluid="minecraft:lava"/>
    </fluids>
    <items id="items"><slots id="output" name="Stage Products" count="33" role="output"/></items>
  </storage>
  <processor id="rock_stew" class="net.modcrafters.minecraft.industrialoverkill.stew.RockStewProcessor"/>
  <screen xmlns="https://moddev.zone/mmdlib/screen" xmlns:io="https://moddev.zone/industrial-overkill/screen">
    <fill name="machine">
      <hbox spacing="6" align="center">
        <hbox spacing="2" align="center">
          <fluid-tank id="tank_0" tank="0" orientation="vertical" length="3s" tooltip="stew.fluid.reserve"/>
          <fluid-tank id="tank_1" tank="1" orientation="vertical" length="3s" tooltip="stew.fluid.reserve"/>
        </hbox>
        <io:stew-line id="processing_line"/>
      </hbox>
    </fill>
    <fill name="tanks"/>
    <fill name="energy"><energy-gauge id="energy" length="3s"/></fill>
  </screen>
</machine>
