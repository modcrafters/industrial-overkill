<?xml version="1.0" encoding="UTF-8"?>
<machine xmlns="https://moddev.zone/mmdlib/machine" version="1"
         extends="industrial_overkill:base_powered_machine" name="Fertilizer Maker">
  <appearance preset="model" model="industrial_overkill:block/fertilizer_maker_body">
    <face-overlay id="display_idle" face="front" x="0" y="0" width="16" height="16"
                  texture="industrial_overkill:block/agricultural/fertilizer_maker/front"
                  when="!($processors.maker.status == 'RUNNING' &amp;&amp; !$processors.maker.paused &amp;&amp; !$processors.maker.held)"/>
    <face-overlay id="display_powered" face="front" x="0" y="0" width="16" height="16"
                  texture="industrial_overkill:block/agricultural/fertilizer_maker/front" emissive="true"
                  when="$processors.maker.status == 'RUNNING' &amp;&amp; !$processors.maker.paused &amp;&amp; !$processors.maker.held"/>
    <part id="powered_sides" model="industrial_overkill:block/machine/agricultural_powered_sides"
          when="$processors.maker.status == 'RUNNING' &amp;&amp; !$processors.maker.paused &amp;&amp; !$processors.maker.held"/>
  </appearance>
  <storage>
    <fluids id="fluids">
      <tank id="sewage" name="Liquid Input" capacity="4000" role="input" fluid-tag="industrial_overkill:fertilizer_maker_inputs"/>
      <tank id="water" name="Water Output" capacity="4000" role="output" fluid="minecraft:water"/>
    </fluids>
    <items id="items">
      <slots id="seeds" name="Compostable Seeds" count="4" role="input" item-tag="industrial_overkill:compostable_seeds"/>
      <slots id="cake" name="Filter Cake" count="1" role="input" item-tag="industrial_overkill:filter_cake"/>
      <slots id="output" name="Fertilizer" count="3" role="output"/>
    </items>
  </storage>
  <processor id="maker" class="net.modcrafters.minecraft.industrialoverkill.waste.FertilizerMakerProcessor"/>
  <screen xmlns="https://moddev.zone/mmdlib/screen">
    <fill name="machine">
      <hbox spacing="6" align="center">
        <fluid-tank id="maker_input" tank="0" orientation="vertical" length="3s" tooltip="waste.maker.liquid_input"/>
        <vbox spacing="2" align="center">
          <inventory id="maker_seeds" storage="seeds" columns="2" spacing="2" slot-tooltip="waste.maker.seeds"/>
          <hbox spacing="2" align="center">
            <inventory id="maker_cake" storage="cake" columns="1" slot-tooltip="waste.maker.cake"/>
            <cycle-button id="maker_mode" variable="$processors.maker.mode" tooltip="waste.maker.cycle">
              <cycle-mode value="0" action="industrial_overkill:maker_liquid" icon="industrial_overkill:sewage_strain"
                          label="waste.maker.mode.0" tooltip="waste.maker.help.0"/>
              <cycle-mode value="1" action="industrial_overkill:maker_pellets" icon="industrial_overkill:fertilizing_pellets"
                          label="waste.maker.mode.1" tooltip="waste.maker.help.1"/>
            </cycle-button>
          </hbox>
        </vbox>
        <progress id="maker_progress" direction="right" jei-recipes="industrial_overkill:fertilizer_maker"
                  value="net.modcrafters.minecraft.industrialoverkill.waste.FertilizerMakerProcessor#progress"
                  max="net.modcrafters.minecraft.industrialoverkill.waste.FertilizerMakerProcessor#progressMax"/>
        <inventory id="maker_output" storage="output" columns="1" spacing="2" slot-tooltip="waste.maker.output"/>
        <fluid-tank id="maker_water" tank="1" orientation="vertical" length="3s" tooltip="waste.maker.water_output"/>
      </hbox>
    </fill>
    <fill name="tanks"/>
  </screen>
</machine>
